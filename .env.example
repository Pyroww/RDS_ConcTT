# Defina estes valores em Vercel > Project > Settings > Environment Variables.
# NUNCA cole a chave secreta do Supabase em arquivos públicos ou no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE_SOMENTE_NA_VERCEL
# Uma senha longa e única para o expositor (recomendado: 16+ caracteres)
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
# Segredo aleatório de pelo menos 32 caracteres para cookies assinados.
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Token dedicado a ponte do notebook (gerar string aleatoria com 64+ caracteres)
BRIDGE_TOKEN=SUBSTITUA_POR_TOKEN_FORTE_UNICO_DE_64_CARACTERES
